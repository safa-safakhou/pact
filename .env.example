NODE_ENV=development
HOST=127.0.0.1
PORT=3000
WEB_PORT=5173
DATABASE_URL=postgres://pact:pact@127.0.0.1:5432/pact
TEST_DATABASE_URL=postgres://pact:pact@127.0.0.1:5432/pact_test
LOG_LEVEL=info
PACT_ORIGIN=http://127.0.0.1:5173
# Optional public path prefix when PACT shares a TLS hostname on the single VPS.
# PACT_PUBLIC_BASE_URL=https://example.com/pact
CURRENT_TERMS_VERSION=development-v1
# Public development-only fixtures. Production startup rejects these values.
IDENTITY_TOKEN_PEPPER=CqWSQq6gBenmbgNM7GRZsQuPkj4EgO0psoaTUmteeK0
IDENTITY_ENCRYPTION_KEY=PzS19vXA8bs49_7DwIY8nKGkQUmVXdmOrFoQ-1pe4LA
# Production requires a newline-delimited offline SHA-256 digest set.
# COMPROMISED_PASSWORD_SHA256_FILE=/run/secrets/compromised-password-sha256.txt
# The API mounts only the public wrapping key. Keep the matching private key in the inference process.
# Production requires MODEL_CREDENTIAL_WRAPPING_PUBLIC_KEY_FILE.
# MODEL_CREDENTIAL_WRAPPING_PUBLIC_KEY_FILE=/run/secrets/model-credential-wrapping-public.pem
MODEL_CREDENTIAL_WRAPPING_KEY_ID=vps-primary-v1
# Required to run raid settlement locally: generate a private 32-byte key (e.g. openssl rand -base64 32).
# RAID_SEED_ENCRYPTION_KEY_BASE64=<private-base64-key>
# Production requires this append-only file outside PostgreSQL backup volumes.
# PACT_DELETION_REGISTRY_FILE=/var/lib/pact-state/deletion-registry.ndjson
# Registration remains closed unless this file exists, validates, and explicitly enables it.
# PACT_OPERATOR_REGISTER_FILE=/etc/pact/operator/operator-register.json
# Optional Telegram Mini App channel. Configure all three values together.
# TELEGRAM_BOT_ID=123456789
# TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
