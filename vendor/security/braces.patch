+// PACT backport: protect all recursive walkers, including caller-supplied ASTs.
+exports.assertDepth = ast => {
+  const pending = [{ node: ast, depth: 0, exit: false }];
+  const ancestors = new Set();
+  while (pending.length) {
+    const { node, depth, exit } = pending.pop();
+    if (exit) { ancestors.delete(node); continue; }
+    if (depth > 128) throw new SyntaxError('Brace nesting exceeds maximum depth (128)');
+    if (ancestors.has(node)) throw new SyntaxError('Cyclic brace AST');
+    if (!node || !Array.isArray(node.nodes)) continue;
+    ancestors.add(node);
+    pending.push({ node, depth, exit: true });
+    for (let i = node.nodes.length - 1; i >= 0; i--) {
+      pending.push({ node: node.nodes[i], depth: depth + 1, exit: false });
+    }
+  }
+};
