{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/coverage",
      "!!.tmp",
      "!!node_modules",
      "!!docs",
      "!!product-discovery",
      "!!vendor/security"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
