  "milestones": {
    "0": {
      "id": "f8db801f-0b68-4ad5-a024-a751ae664781",
      "name": "0 — Connections",
      "description": "31 tickets. Account/credential foundations, five provider adapters, MCP, approvals, bounded runs, Telegram authentication, privacy, and real MVP connection certification. Signed native certification is deferred to Season One release. Exit: PACT-027, criteria A01–A09.",
      "progress": 0,
      "sortOrder": -12
    },
    "1": {
      "id": "26677b8a-2713-4bdb-9d31-5ef324d85b21",
      "name": "1 — Transactional rules",
      "description": "27 tickets. Deterministic rules, atomic clock/resource ledger, economy, units, contracts, scouting/combat, authorized UI/tools, adversarial checks, and reuse proof. Exit: PACT-053, criteria R01–R08.",
      "progress": 0,
      "sortOrder": 950
    },
    "2": {
      "id": "53ce719b-79d8-4b97-9efa-97c9f220422c",
      "name": "2 — Social slice",
      "description": "20 tickets. Profiles, Courts, Articles, evidence, sharing, web/Telegram/assistant surfaces, notifications, privacy/moderation, load tests, and a real three-week 50-player pilot. Exit: PACT-068, criteria S01–S08.",
      "progress": 0,
      "sortOrder": 2016
    },
    "3": {
      "id": "80a160f5-7996-41db-b281-470ae9541ba6",
      "name": "3 — Season One release",
      "description": "20 tickets. Native clients and signing, seasons/honors, art/audio/accessibility, cosmetics and platform purchases, production operator facts, operations/distribution certification, and release rehearsal. Exit: PACT-081, criteria L01–L06.",
      "progress": 0,
      "sortOrder": 2933
    }
  },
