PACT_COMPOSE_PROJECT=pact-connection-test
PACT_IMAGE=pact-runtime:connection-test
PACT_GATEWAY_IMAGE=pact-gateway:connection-test
PACT_ORIGIN=https://example.com
PACT_PUBLIC_BASE_URL=https://example.com/pact
PACT_WEB_BASE_PATH=/pact/
PACT_TELEGRAM_BASE_PATH=/pact/telegram/
PACT_LOOPBACK_PORT=8088
PACT_EDGE_NETWORK=pact-edge
PACT_SECRETS_DIR=/srv/pact/secrets/connection-test
PACT_STATE_DIR=/srv/pact/state
CURRENT_TERMS_VERSION=connection-test-v1
MODEL_CREDENTIAL_WRAPPING_KEY_ID=vps-primary-v1
PACT_ENABLE_LIVE_MODEL_CALLS=0
# OpenRouter stays unregistered until an operator supplies reviewed routing disclosure.
OPENROUTER_ROUTING_DISCLOSURE=
LOG_LEVEL=info

# Optional browser notifications. Private key belongs only to the notification worker.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
