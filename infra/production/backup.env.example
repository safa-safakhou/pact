# Zero-cost MVP: encrypted repository on the single VPS. This protects against
# database/operator mistakes, not loss of the server or its disk.
PACT_LOCAL_BACKUP_DIR=/srv/pact/backups/restic
RESTIC_REPOSITORY=/repository
RESTIC_PASSWORD_FILE=/srv/pact/secrets/connection-test/restic_password
# Production hardening may replace the local repository with off-host storage.
# Provider credentials are supplied only in the root-readable runtime copy.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
