{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@pact/contracts": ["./packages/contracts/src/index.ts"],
      "@pact/platform": ["./packages/platform/src/index.ts"],
      "@pact/domain": ["./packages/domain/src/index.ts"],
      "@pact/world": ["./packages/world/src/index.ts"],
      "@pact/ledger": ["./packages/ledger/src/index.ts"],
      "@pact/kingdom": ["./packages/kingdom/src/index.ts"],
      "@pact/application": ["./packages/application/src/index.ts"],
      "@pact/db": ["./packages/db/src/index.ts"],
      "@pact/telemetry": ["./packages/telemetry/src/index.ts"],
      "@pact/identity": ["./packages/identity/src/index.ts"],
      "@pact/identity/portable": ["./packages/identity/src/portable.ts"],
      "@pact/onboarding": ["./packages/onboarding/src/index.ts"],
      "@pact/oauth": ["./packages/oauth/src/index.ts"],
      "@pact/authority": ["./packages/authority/src/index.ts"],
      "@pact/mcp": ["./packages/mcp/src/index.ts"],
      "@pact/approvals": ["./packages/approvals/src/index.ts"],
      "@pact/approvals/portable": ["./packages/approvals/src/portable.ts"],
      "@pact/inbox": ["./packages/inbox/src/index.ts"],
      "@pact/inbox/portable": ["./packages/inbox/src/portable.ts"],
      "@pact/credential-vault": ["./packages/credential-vault/src/index.ts"],
      "@pact/model-provider": ["./packages/model-provider/src/index.ts"],
      "@pact/runs": ["./packages/runs/src/index.ts"],
      "@pact/runs/portable": ["./packages/runs/src/portable.ts"],
      "@pact/client-sdk": ["./packages/client-sdk/src/index.ts"],
      "@pact/ui-features": ["./packages/ui-features/src/index.ts"],
      "@pact/openrouter": ["./packages/openrouter/src/index.ts"],
      "@pact/telegram": ["./packages/telegram/src/index.ts"],
      "@pact/privacy": ["./packages/privacy/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "workers/**/*.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
